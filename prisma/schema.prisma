datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  BUYER
  SELLER
  WAREHOUSE_STAFF
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum WalletTxType {
  DEPOSIT
  WITHDRAWAL
  ORDER_PAYMENT
  ORDER_REFUND
  COMMISSION_FEE
  SELLER_PAYOUT
  BONUS_CREDIT
}

enum AuditSeverity {
  INFO
  WARN
  HIGH
  CRITICAL
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String?
  fullName      String
  phone         String?
  avatarUrl     String?
  role          RoleType      @default(BUYER)
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  addresses          Address[]
  orders             Order[]
  reviews            ProductReview[]
  wallet             Wallet?
  notifications      Notification[]
  sellerAccount      SellerAccount?
  adminAccount       AdminAccount?
  auditLogs          AuditLog[]
  carts              Cart[]
  wishlists          Wishlist[]

  @@index([email])
  @@index([role])
}

model Address {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String    @default("US")
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders       Order[]

  @@index([userId])
}

model SellerAccount {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName    String        @unique
  rating       Float         @default(5.0)
  totalSales   Int           @default(0)
  status       AccountStatus @default(PENDING_VERIFICATION)
  kycVerified  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  products     Product[]
  orderItems   OrderItem[]
  wallet       Wallet?

  @@index([storeName])
}

model AdminAccount {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   String
  clearance    String   @default("STANDARD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime   @default(now())

  products    Product[]
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  logoUrl     String?   
  createdAt   DateTime  @default(now())

  products    Product[]
}

model Product {
  id           String         @id @default(uuid())
  sku          String         @unique
  title        String
  description  String
  price        Float
  msrp         Float?
  rating       Float          @default(4.5)
  reviewCount  Int            @default(0)
  inStock      Boolean        @default(true)
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  brandId      String?
  brand        Brand?         @relation(fields: [brandId], references: [id])
  sellerId     String?
  seller       SellerAccount? @relation(fields: [sellerId], references: [id])
  imageUrl     String?
  tags         String[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  variants     ProductVariant[]
  inventories  Inventory[]
  orderItems   OrderItem[]
  reviews      ProductReview[]
  priceHistory ProductPriceHistory[]

  @@index([sku])
  @@index([title])
  @@index([categoryId])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  name      String
  color     String?
  size      String?
  price     Float
  stock     Int      @default(0)

  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
}

model ProductPriceHistory {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice  Float
  newPrice  Float
  reason    String?
  createdAt DateTime @default(now())
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String
  comment   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model Warehouse {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  city          String
  country       String   @default("US")
  capacityUnits Int      @default(100000)
  utilizedUnits Int      @default(0)
  status        String   @default("OPERATIONAL")
  createdAt     DateTime @default(now())

  inventories   Inventory[]
}

model Inventory {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockOnHand   Int       @default(0)
  reservedUnits Int       @default(0)
  reorderLevel  Int       @default(50)
  updatedAt     DateTime  @updatedAt

  history       InventoryHistory[]

  @@unique([productId, warehouseId])
}

model InventoryHistory {
  id          String    @id @default(uuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  changeQty   Int
  reason      String
  createdAt   DateTime  @default(now())
}

model Order {
  id                String            @id @default(uuid())
  orderNumber       String            @unique
  customerId        String
  customer          User              @relation(fields: [customerId], references: [id])
  status            OrderStatus       @default(CREATED)
  totalAmount       Float
  currency          String            @default("USD")
  shippingAddressId String?
  shippingAddress   Address?          @relation(fields: [shippingAddressId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payments          PaymentRecord[]
  shippings         ShippingRecord[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  sellerId      String?
  seller        SellerAccount?  @relation(fields: [sellerId], references: [id])
  quantity      Int
  unitPrice     Float
  totalPrice    Float
  createdAt     DateTime        @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())
}

model Wallet {
  id            String              @id @default(uuid())
  userId        String?             @unique
  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId      String?             @unique
  seller        SellerAccount?      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  balance       Float               @default(0.0)
  frozenBalance Float               @default(0.0)
  currency      String              @default("USD")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  transactions  WalletTransaction[]
  history       WalletBalanceHistory[]
}

model WalletTransaction {
  id            String       @id @default(uuid())
  walletId      String
  wallet        Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount        Float
  type          WalletTxType
  status        String       @default("COMPLETED")
  description   String
  referenceId   String?
  createdAt     DateTime     @default(now())

  @@index([walletId])
}

model WalletBalanceHistory {
  id         String   @id @default(uuid())
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  oldBalance Float
  newBalance Float
  reason     String
  createdAt  DateTime @default(now())
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Float?
  discountAmount  Float?
  maxUses         Int       @default(1000)
  currentUses     Int       @default(0)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  isActive        Boolean   @default(true)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  channel   String   @default("IN_APP")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AIRequestLog {
  id         String   @id @default(uuid())
  prompt     String
  model      String   @default("gemini-3.6-flash")
  domain     String   @default("GENERAL")
  status     String   @default("SUCCESS")
  tokensUsed Int      @default(0)
  latencyMs  Int      @default(0)
  createdAt  DateTime @default(now())
}

model PaymentRecord {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod  String
  amount         Float
  currency       String   @default("USD")
  status         String   @default("COMPLETED")
  gatewayRef     String?
  createdAt      DateTime @default(now())
}

model ShippingRecord {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String
  trackingNumber String   @unique
  stage          String   @default("IN_TRANSIT")
  estDelivery    String?
  createdAt      DateTime @default(now())
}

model AuditLog {
  id        String        @id @default(uuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  actorType String
  actorId   String
  action    String
  domain    String
  details   String
  severity  AuditSeverity @default(INFO)
  ipAddress String?
  timestamp DateTime      @default(now())

  @@index([domain])
  @@index([timestamp])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  isEncrypted Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
